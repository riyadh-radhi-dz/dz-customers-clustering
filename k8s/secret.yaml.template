# Template for Kubernetes secrets
# Copy this file to secret.yaml and replace the placeholders
# Then encode values with: echo -n "your-value" | base64

apiVersion: v1
kind: Secret
metadata:
  name: dz-clustering-secrets
type: Opaque
data:
  # API Keys (base64 encoded)
  API_KEYS: REPLACE_WITH_BASE64_ENCODED_API_KEYS
  
  # ClickHouse credentials (base64 encoded)
  CLICKHOUSE_HOST: REPLACE_WITH_BASE64_ENCODED_HOST
  CLICKHOUSE_PORT: REPLACE_WITH_BASE64_ENCODED_PORT
  CLICKHOUSE_USERNAME: REPLACE_WITH_BASE64_ENCODED_USERNAME
  CLICKHOUSE_PASSWORD: REPLACE_WITH_BASE64_ENCODED_PASSWORD
  CLICKHOUSE_DATABASE: REPLACE_WITH_BASE64_ENCODED_DATABASE
  
  # MLflow (base64 encoded)
  MLFLOW_TRACKING_URI: REPLACE_WITH_BASE64_ENCODED_URI

